// Cloudflare Worker that serves the static site in public/ (no Worker script).
// Deployed by Workers Builds on push: root directory "site", build watch paths "site/*".
{
  "name": "mmd-to-arp",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mmd-to-arp.utage.studio", "custom_domain": true }
  ]
}
